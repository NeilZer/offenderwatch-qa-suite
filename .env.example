# Target application (your personal instance). Trailing slash optional.
BASE_URL=https://svcdemoaz.puremonitor.supercom.com/AQApplication/Neil/

# Browser timezone used by UI tests. Dates/times on screen are rendered in this zone.
TIMEZONE=Asia/Jerusalem

# Run UI tests with a visible browser (true/false)
HEADED=false

# Optional — only for `npm run platform` (report a command-line run to the Part 5 platform).
# PLATFORM_URL=http://localhost:5080
# PLATFORM_TOKEN=<Platform:IngestToken from the platform's appsettings.json>
